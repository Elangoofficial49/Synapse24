DATABASE_URL=sqlite+aiosqlite:///./pharmatrace.db
SYNC_DATABASE_URL=sqlite:///./pharmatrace.db
SECRET_KEY=replace-with-a-long-random-signing-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
BLOCKCHAIN_MODE=test
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PharmaTrace
DOCUMENT_STORAGE_PATH=./private_documents
DOCUMENT_MAX_SIZE_BYTES=10485760
